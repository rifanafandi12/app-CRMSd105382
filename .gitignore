# ==============================================
# CodeIgniter
# ==============================================
/application/cache/*
!/application/cache/index.html
!/application/cache/.gitkeep

/application/logs/*
!/application/logs/index.html
!/application/logs/.gitkeep

/application/sessions/*

# ==============================================
# Environment Files
# ==============================================
.env
.env.local
.env.*.local
node_server/.env
application/config/database.php.bak

# ==============================================
# Node.js
# ==============================================
node_modules/
node_server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==============================================
# Build Output (Tailwind)
# ==============================================
assets/css/app.css
assets/css/app.min.css
assets/css/*.map

# ==============================================
# Composer
# ==============================================
/vendor/
composer.lock
!composer.json

# ==============================================
# User Uploads (keep folder structure)
# ==============================================
assets/uploads/*
!assets/uploads/.gitkeep
!assets/uploads/**/.gitkeep

# ==============================================
# IDE & Editor
# ==============================================
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.classpath

# ==============================================
# Operating System
# ==============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ==============================================
# Logs & Database
# ==============================================
*.log
logs/
*.sql
!database/schema.sql
!database/seeds/*.sql

# ==============================================
# Testing & Coverage
# ==============================================
.phpunit.result.cache
coverage/
.php-cs-fixer.cache

# ==============================================
# Temporary Files
# ==============================================
*.tmp
*.temp
*.bak
*.orig
